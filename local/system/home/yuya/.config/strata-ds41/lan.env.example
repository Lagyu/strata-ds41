# ~/.config/strata-ds41/lan.env (mode 600) - optional LAN mode. When this file exists, local/run-ds41.sh starts the
# server on DS41_HOST, and the server then wants STRATA_API_KEY from every client (local/warmup.sh and
# restart-ds41.sh read it from here too). Without the file the server listens on 127.0.0.1 only.
DS41_HOST=0.0.0.0
STRATA_API_KEY=replace-with-a-long-random-string
