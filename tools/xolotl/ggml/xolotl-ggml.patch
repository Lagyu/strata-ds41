+// ---- Strata DS4.1 FP4 KV caches (tools/v41/engine/ds41_dense.cpp --kv-fp4).  The graph's fake-quant has already put
+// every value on an FP4 grid - the compressed KV on e2m1 x an E4M3 scale per 16 (NVFP4), the indexer keys on
+// e2m1 x a power-of-2 scale per 32 (MXFP4) - and these two quantizers pack such values EXACTLY: per (sub-)block they
+// try the scales the grid admits (amax / q, q an e2m1 magnitude, snapped to the scale format) and keep the first that
+// reproduces every value bit for bit (checked by multiplication, which is exact here; fast-math division is only used
+// to find candidates).  Values not on such a grid fall back to the q = 6 scale with nearest codes (approximate).
+static __device__ __forceinline__ float ds41_e2m1_mag(int c) {   // code 0..7 -> 0, 0.5, 1, 1.5, 2, 3, 4, 6
+    return c < 4 ? 0.5f * (float) c : (c == 4 ? 2.0f : c == 5 ? 3.0f : c == 6 ? 4.0f : 6.0f);
+}
+static __device__ __forceinline__ int ds41_e2m1_nearest(float v) {   // |v| -> the nearest e2m1 code (ties: lower code)
+    const float a = fminf(fabsf(v), 6.0f);
+    int best = 0; float err = a;
+    for (int c = 1; c < 8; ++c) { const float e = fabsf(a - ds41_e2m1_mag(c)); if (e < err) { err = e; best = c; } }
+    return best;
+}
+// value x and scale s: the code whose value * s == x exactly, or -1
+static __device__ __forceinline__ int ds41_e2m1_exact(float x, float s) {
+    const int c = ds41_e2m1_nearest(x / s);
+    const float m = ds41_e2m1_mag(c);
+    if (m * s == fabsf(x)) return c | (x < 0.0f ? 8 : 0);
+    return -1;
+}
+// x >= 0 -> the nearest E4M3 value (RNE, subnormal spacing 2^-9, saturating at 448), as float
+static __device__ __forceinline__ float ds41_round_e4m3(float x) {
+    if (!(x > 0.0f)) return 0.0f;
+    if (x >= 448.0f) return 448.0f;
+    if (x < 0x1p-6f) return rintf(x * 512.0f) * 0x1p-9f;
+    int e; frexpf(x, &e);                                    // x = m 2^e, m in [0.5, 1): spacing 2^(e-4)
+    const float u = ldexpf(1.0f, e - 4);
+    return rintf(x * ldexpf(1.0f, 4 - e)) * u;
+}
+static __device__ __forceinline__ uint8_t ds41_e4m3_bits(float s) {   // s an E4M3 value > 0
+    if (s < 0x1p-6f) return (uint8_t) (int) (s * 512.0f);
+    int e; const float m = frexpf(s, &e);                    // s = (2m) 2^(e-1)
+    return (uint8_t) (((e - 1 + 7) << 3) | ((int) ((2.0f * m - 1.0f) * 8.0f + 0.5f) & 7));
+}
