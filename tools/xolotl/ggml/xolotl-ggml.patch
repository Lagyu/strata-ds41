+static void ggml_ds41_fused_set(struct ggml_tensor * result, int sub_op, struct ggml_tensor ** srcs, int n_src,
+                                const int32_t * params, int n_params) {
+    GGML_ASSERT(n_src >= 1 && n_src <= GGML_MAX_SRC);
+    GGML_ASSERT(n_params >= 0 && n_params <= 15);
+    int32_t p[16] = { 0 };
+    p[0] = sub_op;
+    if (n_params > 0) {
+        memcpy(p + 1, params, (size_t) n_params * sizeof(int32_t));
+    }
+    ggml_set_op_params(result, p, sizeof(p));
+    result->op = GGML_OP_DS41_FUSED;
+    for (int i = 0; i < n_src; ++i) {
+        GGML_ASSERT(srcs[i] != NULL);
+        result->src[i] = srcs[i];
+    }
+}
+
+struct ggml_tensor * ggml_ds41_fused(
+        struct ggml_context * ctx,
+        int                   sub_op,
+        struct ggml_tensor ** srcs,
+        int                   n_src,
+        enum ggml_type        type,
+        int64_t               ne0,
+        int64_t               ne1,
+        int64_t               ne2,
+        int64_t               ne3,
+        const int32_t       * params,
+        int                   n_params) {
+    const int64_t ne[4] = { ne0, ne1, ne2, ne3 };
+    struct ggml_tensor * result = ggml_new_tensor(ctx, type, 4, ne);
+    ggml_ds41_fused_set(result, sub_op, srcs, n_src, params, n_params);
+    return result;
+}
