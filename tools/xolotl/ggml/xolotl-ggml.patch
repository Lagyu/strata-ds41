diff --git a/ggml/src/ggml-cuda/ds41-fused.cu b/ggml/src/ggml-cuda/ds41-fused.cu
new file mode 100644
index 0000000..fd741e1
--- /dev/null
+++ b/ggml/src/ggml-cuda/ds41-fused.cu
@@ -0,0 +1,660 @@
+// Strata-DS4.1 fused decode-layer glue (GGML_OP_DS41_FUSED).  Each sub-op repeats, step for step and in the same
+// reduction order, the stock-op composite tools/v41/engine/ds41_dense.cpp built before it (the kernels it replaces are
+// named at each one), so the values are the same bits.  The gate: ds41_generate --dense-bench rows compared with cmp,
+// STRATA_DENSE_FUSED=0 against the default.  The sub-op ids and their src / param contracts are shared with
+// ds41_dense.cpp (ds41_fused_ops.hpp); a mismatch is a hard abort here.
+#include "common.cuh"
+#include "convert.cuh"
+#include "ds41-fused.cuh"
+
+#include <cmath>
+#include <cstdint>
+
+enum ds41f_sub_op {
+    DS41F_NONE            = 0,
+    DS41F_HC_PRE_NORM     = 1,   // rms_norm(hc_pre(x, pre)) * w                    (dsv4_hc_pre_f32 + rms_norm_f32<.., true>)
+    DS41F_ATTN_K          = 3,   // the attention's K (= V) rows of every query, F16  (cast + concat + get_rows x2 + concat + pad + cast)
+    DS41F_ATTN_MASK       = 4,   // ... and their mask, F16                           (concat + fill + concat + cast)
+    DS41F_ROUTER          = 5,   // sqrt(softplus) + biases, top-k ids, normalized weights (unary x2, add x2, argsort_top_k, get_rows, sum_rows, scale, div, scale)
+    DS41F_HC_TAIL         = 7,   // h = hc_post(attn, x, post(mixes), comb(mixes))     (dsv41_hc_mixes + dsv4_hc_comb + dsv4_hc_post)
+    DS41F_FFN_MIX         = 8,   // pre / post / comb of the FFN mixes into the state  (dsv41_hc_mixes + dsv4_hc_comb + 3 cpy)
+    DS41F_HC_PRE_NORM_MIX = 9,   // DS41F_HC_PRE_NORM with the pre mix taken from the attention mixes
+    DS41F_FINISH          = 10,  // x_state = hc_post(shexp + routed, hap, post_f, comb_f)   (add + dsv4_hc_post + cpy)
+};
+
+static constexpr int DS41F_HC  = 4;                           // hc_mult (dsv4-hc.cu's DSV4_HC)
+static constexpr int DS41F_MIX = (2 + DS41F_HC) * DS41F_HC;   // mixes rows per token: pre | post | comb
+
+// ---------------------------------------------------------------- the hc mixes (dsv41_hc_mixes_f32 / dsv4_hc_comb_f32)
+
+static __device__ __forceinline__ float ds41f_sigmoid(float x) {
+    return 1.0f / (1.0f + expf(-x));
+}
+
+// the pre mix of token t, hc h: dsv41_hc_mixes_f32's pre branch
+static __device__ __forceinline__ float ds41f_mix_pre(const float * mixes, int64_t nrow, const float * scale, const float * base,
+                                                      int64_t t, int h, float eps) {
+    const float v = __fadd_rn(__fmul_rn(mixes[h + nrow*t], scale[0]), base[h]);
+    return __fmaf_rn(1.0f, ds41f_sigmoid(v), eps);
+}
+
+// the post mix: dsv41_hc_mixes_f32's post branch
+static __device__ __forceinline__ float ds41f_mix_post(const float * mixes, int64_t nrow, const float * scale, const float * base,
+                                                       int64_t t, int h) {
+    const int   r = DS41F_HC + h;
+    const float v = __fadd_rn(__fmul_rn(mixes[r + nrow*t], scale[1]), base[r]);
+    return __fmaf_rn(2.0f, ds41f_sigmoid(v), 0.0f);
+}
+
+static __device__ void ds41f_comb_norm_cols(float * comb, float eps) {
+    for (int idst = 0; idst < DS41F_HC; ++idst) {
+        float sum = eps;
+        for (int isrc = 0; isrc < DS41F_HC; ++isrc) {
+            sum += comb[idst + DS41F_HC*isrc];
+        }
+        const float inv_sum = 1.0f / sum;
+        for (int isrc = 0; isrc < DS41F_HC; ++isrc) {
+            comb[idst + DS41F_HC*isrc] *= inv_sum;
+        }
+    }
+}
+
+static __device__ void ds41f_comb_norm_rows(float * comb, float eps) {
+    for (int isrc = 0; isrc < DS41F_HC; ++isrc) {
+        float sum = eps;
+        for (int idst = 0; idst < DS41F_HC; ++idst) {
+            sum += comb[idst + DS41F_HC*isrc];
+        }
+        const float inv_sum = 1.0f / sum;
+        for (int idst = 0; idst < DS41F_HC; ++idst) {
+            comb[idst + DS41F_HC*isrc] *= inv_sum;
+        }
+    }
+}
+
+// comb[idst + HC*isrc] of token `it`: dsv4_hc_comb_f32's body (mixes rows 2*HC.., scale[2], base[2*HC..])
+static __device__ void ds41f_comb(const float * mixes, int64_t sm0, int64_t sm1, const float * scale, int64_t ss0,
+                                  const float * base, int64_t sb0, int64_t it, float eps, int32_t n_iter, float * comb) {
+    constexpr int comb_offset = 2*DS41F_HC;
+    const float scale_comb = scale[2*ss0];
+    for (int isrc = 0; isrc < DS41F_HC; ++isrc) {
+        float max = -INFINITY;
+        for (int idst = 0; idst < DS41F_HC; ++idst) {
+            const int idx = idst + DS41F_HC*isrc;
+            const float v = mixes[(comb_offset + idx)*sm0 + it*sm1] * scale_comb + base[(comb_offset + idx)*sb0];
+            comb[idx] = v;
+            max = fmaxf(max, v);
+        }
+        float sum = 0.0f;
+        for (int idst = 0; idst < DS41F_HC; ++idst) {
+            const int idx = idst + DS41F_HC*isrc;
+            const float v = expf(comb[idx] - max);
+            comb[idx] = v;
+            sum += v;
+        }
+        const float inv_sum = 1.0f / sum;
+        for (int idst = 0; idst < DS41F_HC; ++idst) {
+            const int idx = idst + DS41F_HC*isrc;
+            comb[idx] = comb[idx] * inv_sum + eps;
+        }
+    }
+    ds41f_comb_norm_cols(comb, eps);
+    for (int32_t i = 1; i < n_iter; ++i) {
+        ds41f_comb_norm_rows(comb, eps);
+        ds41f_comb_norm_cols(comb, eps);
+    }
+}
+
+// ---------------------------------------------------------------- 1 / 9: rms_norm(hc_pre(x, pre)) * w
+
+// One block per token: dsv4_hc_pre_f32<false> (sum over hc of x * pre, times its scale) feeding rms_norm_f32<block_size,
+// true> (sum of squares, block_reduce, scale * x * w).  from_mixes: pre = the attention mixes' pre mix (DS41F_HC_PRE_NORM_MIX).
+template <int block_size, bool from_mixes>
+static __global__ void ds41f_hc_pre_norm_f32(
+        const float * x, int64_t sx0, int64_t sx1, int64_t sx2,
+        const float * pre, int64_t sp0, int64_t sp1,
+        const float * scale, const float * base, float hc_eps,
+        const float * w, float * dst, int ncols, float eps, float hc_scale) {
+    const int it  = blockIdx.x;
+    const int tid = threadIdx.x;
+    float wv[DS41F_HC];
+#pragma unroll
+    for (int ih = 0; ih < DS41F_HC; ++ih) {
+        if constexpr (from_mixes) {
+            wv[ih] = ds41f_mix_pre(pre, sp0, scale, base, it, ih, hc_eps);
+        } else {
+            wv[ih] = pre[ih*sp0 + it*sp1];
+        }
+    }
+    // explicit intrinsics: with -ffp-contract=fast the compiler may fuse either product of `a*b + c*d` - the composite's
+    // runtime loops pin fma(x, w, sum) from sum = 0, then rms_norm's fma(xi, xi, tmp); these pin the same order
+    float tmp = 0.0f;
+    for (int col = tid; col < ncols; col += block_size) {
+        float sum = 0.0f;
+        for (int64_t ih = 0; ih < DS41F_HC; ++ih) {
+            const float xv = x[col*sx0 + ih*sx1 + it*sx2];
+            const float wvv = wv[ih];
+            sum = __fmaf_rn(xv, wvv, sum);
+        }
+        const float xi = __fmul_rn(hc_scale, sum);
+        tmp = __fmaf_rn(xi, xi, tmp);
+    }
+    __shared__ float s_sum[32];
+    tmp = block_reduce<block_reduce_method::SUM, block_size>(tmp, s_sum);
+    const float mean  = tmp / ncols;
+    const float scl   = rsqrtf(mean + eps);
+    float * out = dst + (int64_t) it * ncols;
+    for (int col = tid; col < ncols; col += block_size) {
+        float sum = 0.0f;
+        for (int64_t ih = 0; ih < DS41F_HC; ++ih) {
+            const float xv = x[col*sx0 + ih*sx1 + it*sx2];
+            const float wvv = wv[ih];
+            sum = __fmaf_rn(xv, wvv, sum);
+        }
+        const float xi = __fmul_rn(hc_scale, sum);
+        out[col] = __fmul_rn(__fmul_rn(scl, xi), w[col]);
+    }
+}
+
+// ---------------------------------------------------------------- 7: h = hc_post(attn, x, post, comb)
+
+// dsv4_hc_post_f32<true> with the post mix and the comb computed per block from the attention mixes.  A block never
+// spans two tokens (n_embd * HC % blockDim == 0: checked by the host).
+static __global__ void ds41f_hc_tail_f32(
+        const float * mixes, int64_t sm0, int64_t sm1, const float * scale, int64_t ss0, const float * base, int64_t sb0,
+        const float * attn, int64_t sa0, int64_t sa1,
+        const float * res, int64_t sr0, int64_t sr1, int64_t sr2,
+        float * dst, int64_t sd0, int64_t sd1, int64_t sd2,
+        int64_t n_embd, int64_t n_tokens, float hc_eps, int32_t n_iter) {
+    __shared__ float s_post[DS41F_HC];
+    __shared__ float s_comb[DS41F_HC*DS41F_HC];
+    const int64_t ir     = (int64_t) blockIdx.x * blockDim.x + threadIdx.x;
+    const int64_t nr     = n_embd * DS41F_HC * n_tokens;
+    const int64_t it_blk = ((int64_t) blockIdx.x * blockDim.x) / (n_embd * DS41F_HC);
+    // thread 0 alone, as dsv4_hc_comb_f32 (a 4-lane version with the same operation order measured 33 -> 21 us but
+    // not the same bits: the single-thread code lets the compiler fuse `comb *= inv_sum` into the next phase's
+    // `sum += comb` across statements, which values passing through shuffles cannot reproduce; ~0.2% of a decode)
+    if (threadIdx.x == 0 && it_blk < n_tokens) {
+        for (int h = 0; h < DS41F_HC; ++h) {
+            s_post[h] = ds41f_mix_post(mixes, sm1, scale, base, it_blk, h);
+        }
+        ds41f_comb(mixes, sm0, sm1, scale, ss0, base, sb0, it_blk, hc_eps, n_iter, s_comb);
+    }
+    __syncthreads();
+    if (ir >= nr) {
+        return;
+    }
+    const int64_t i0   = ir % n_embd;
+    const int64_t idst = (ir / n_embd) % DS41F_HC;
+    const int64_t it   = ir / (n_embd * DS41F_HC);
+    // dsv4_hc_post_f32: the product first (v_mul), then one fma per hc (its runtime loop's v_fmac) - pinned, see above
+    float sum = __fmul_rn(attn[i0*sa0 + it*sa1], s_post[idst]);
+    for (int64_t isrc = 0; isrc < DS41F_HC; ++isrc) {
+        sum = __fmaf_rn(res[i0*sr0 + isrc*sr1 + it*sr2], s_comb[idst + DS41F_HC*isrc], sum);
+    }
+    dst[i0*sd0 + idst*sd1 + it*sd2] = sum;
+}
+
+// ---------------------------------------------------------------- 8: the FFN mixes into the state
+
+// one thread per token: pre_out / post_out [HC, n], comb_out [HC, HC, n] (the composite's cpy targets, same layouts)
+static __global__ void ds41f_ffn_mix_f32(
+        const float * mixes, int64_t sm0, int64_t sm1, const float * scale, int64_t ss0, const float * base, int64_t sb0,
+        float * pre_out, int64_t spo0, int64_t spo1, float * post_out, int64_t sqo0, int64_t sqo1,
+        float * comb_out, int64_t sc0, int64_t sc1, int64_t sc2, int64_t n_tokens, float hc_eps, int32_t n_iter) {
+    const int64_t it = (int64_t) blockIdx.x * blockDim.x + threadIdx.x;
+    if (it >= n_tokens) {
+        return;
+    }
+    for (int h = 0; h < DS41F_HC; ++h) {
+        pre_out[h*spo0 + it*spo1]  = ds41f_mix_pre(mixes, sm1, scale, base, it, h, hc_eps);
+        post_out[h*sqo0 + it*sqo1] = ds41f_mix_post(mixes, sm1, scale, base, it, h);
+    }
+    float comb[DS41F_HC*DS41F_HC];
+    ds41f_comb(mixes, sm0, sm1, scale, ss0, base, sb0, it, hc_eps, n_iter, comb);
+    for (int isrc = 0; isrc < DS41F_HC; ++isrc) {
+        for (int idst = 0; idst < DS41F_HC; ++idst) {
+            comb_out[idst*sc0 + isrc*sc1 + it*sc2] = comb[idst + DS41F_HC*isrc];
+        }
+    }
+}
+
+// ---------------------------------------------------------------- 10: finish
+
+// k_bin_bcast<op_add>(shexp, routed) feeding dsv4_hc_post_f32<true>(out, hap, post_f, comb_f) -> x_state
+static __global__ void ds41f_finish_f32(
+        const float * shexp, int64_t se0, int64_t se1, const float * routed, int64_t sr0, int64_t sr1,
+        const float * hap, int64_t sh0, int64_t sh1, int64_t sh2, const float * post, int64_t sp0, int64_t sp1,
+        const float * comb, int64_t sc0, int64_t sc1, int64_t sc2,
+        float * dst, int64_t sd0, int64_t sd1, int64_t sd2, int64_t n_embd, int64_t n_tokens) {
+    const int64_t ir = (int64_t) blockIdx.x * blockDim.x + threadIdx.x;
+    const int64_t nr = n_embd * DS41F_HC * n_tokens;
+    if (ir >= nr) {
+        return;
+    }
+    const int64_t i0   = ir % n_embd;
+    const int64_t idst = (ir / n_embd) % DS41F_HC;
+    const int64_t it   = ir / (n_embd * DS41F_HC);
+    const float out = __fadd_rn(shexp[i0*se0 + it*se1], routed[i0*sr0 + it*sr1]);
+    float sum = __fmul_rn(out, post[idst*sp0 + it*sp1]);   // pinned as in ds41f_hc_tail_f32
+    for (int64_t isrc = 0; isrc < DS41F_HC; ++isrc) {
+        sum = __fmaf_rn(hap[i0*sh0 + isrc*sh1 + it*sh2], comb[idst*sc0 + isrc*sc1 + it*sc2], sum);
+    }
+    dst[i0*sd0 + idst*sd1 + it*sd2] = sum;
+}
+
+// ---------------------------------------------------------------- 5: the router
+
+// One warp per token row, as k_argsort_topk_warp_f32_i32 (argsort.cu, the DESC order: larger score first, equal scores
+// by the lower column).  Per column: sc = sqrtf(softplus(rl)) (unary_op_kernel x2), s0 = sc + bias, sel = s0 + rbias
+// (k_bin_bcast<op_add> x2); the top-k keys come from sel, the weights are sc at the selected columns (k_get_rows_float);
+// full: sum = reduce_rows_f32 (block_reduce over a 512-thread block: lanes 0..k-1 of warp 0 hold the k values, the
+// rest zeros, then the cross-warp stage over [S, 0, ...]), den = scale_f32(sum, 1, 1e-20), w = w / den (op_div),
+// w = scale_f32(w, weights_scale, 0).
+template <int NPL, bool full>
+static __global__ void ds41f_router_f32(const float * __restrict__ rl, const int ncols, const float * __restrict__ bias,
+                                        const float * __restrict__ rbias, const int nrows, const int k,
+                                        float * __restrict__ wts, const int64_t sw0, const int64_t sw1,
+                                        int * __restrict__ ids, const int64_t si0, const int64_t si1,
+                                        const int norm_topk, const float den_scale, const float den_bias, const float w_scale, const float w_bias) {
+    const int row = blockIdx.x * (blockDim.x / 32) + threadIdx.x / 32;
+    if (row >= nrows) {
+        return;
+    }
+    const int lane = threadIdx.x & 31;
+    const float * x_row = rl + (int64_t) row * ncols;
+    unsigned long long key[NPL];
+    float scv[NPL];
+#pragma unroll
+    for (int i = 0; i < NPL; ++i) {
+        const int c = lane + 32 * i;
+        unsigned long long kk = ~0ull;
+        float sc = 0.0f;
+        if (c < ncols) {
+            const float v  = x_row[c];
+            const float sp = (v > 20.0f) ? v : logf(1.0f + expf(v));
+            sc = sqrtf(sp);
+            const float s0  = sc + bias[c];
+            const float sel = s0 + rbias[c];
+            const unsigned u = __float_as_uint(sel);
+            unsigned kv = (u & 0x80000000u) ? ~u : (u | 0x80000000u);
+            kv = ~kv;
+            kk = ((unsigned long long) kv << 32) | (unsigned) c;
+        }
+        key[i] = kk;
+        scv[i] = sc;
+    }
+    unsigned long long best = ~0ull;
+#pragma unroll
+    for (int i = 0; i < NPL; ++i) {
+        best = key[i] < best ? key[i] : best;
+    }
+    float mine = 0.0f;   // lane j < k: the weight of the j-th pick
+    for (int j = 0; j < k; ++j) {
+        unsigned long long m = best;
+#pragma unroll
+        for (int off = 16; off > 0; off >>= 1) {
+            const unsigned long long o = __shfl_xor_sync(0xFFFFFFFFu, m, off, 32);
+            m = o < m ? o : m;
+        }
+        const int col = (int) (m & 0xFFFFFFFFull);
+        const int ii  = col >> 5;
+        float sval = 0.0f;
+#pragma unroll
+        for (int i = 0; i < NPL; ++i) {
+            if (i == ii) {
+                sval = scv[i];
+            }
+        }
+        const float wj = __shfl_sync(0xFFFFFFFFu, sval, col & 31, 32);
+        if (lane == j) {
+            mine = wj;
+        }
+        if (lane == 0) {
+            if constexpr (full) {
+                ids[j*si0 + (int64_t) row*si1] = col;
+            } else {
+                ids[j + (int64_t) row*k] = col;
+            }
+        }
+        if (lane == (col & 31)) {
+            best = ~0ull;
+#pragma unroll
+            for (int i = 0; i < NPL; ++i) {
+                if (i == ii) {
+                    key[i] = ~0ull;
+                }
+                best = key[i] < best ? key[i] : best;
+            }
+        }
+    }
+    if constexpr (full) {
+        float s = warp_reduce_sum(lane < k ? mine : 0.0f);
+        s = warp_reduce_sum(lane == 0 ? s : 0.0f);
+        float w = mine;
+        if (norm_topk) {
+            const float den = __fmaf_rn(den_scale, s, den_bias);   // scale_f32: one fma
+            w = w / den;
+        }
+        w = __fmaf_rn(w_scale, w, w_bias);
+        if (lane < k) {
+            wts[lane*sw0 + (int64_t) row*sw1] = w;
+        }
+    }
+}
+
+// ---------------------------------------------------------------- 3 / 4: the attention's keys and mask
+
+// dst [DH, M, 1, n] F16: query t's row j < SWA = row widx[t*SWA + j] of [ring | the pass's kv2 rows] (the ring BF16 ->
+// F32 cast, the F32 -> F16 cast of the composite's ggml_cast), SWA <= j < SWA + K = compressed row sel[t][j - SWA]
+// (F32 / BF16 rows cast; NVFP4 rows as dequantize_nvfp4<float> (dequantize.cuh) then cast), the rest 0 (ggml_pad).
+template <typename ring_t, int comp_kind>   // comp_kind: 0 none, 1 F32, 2 BF16, 3 NVFP4
+static __global__ void ds41f_attn_k_f16(const float * __restrict__ kv2, const void * __restrict__ ring, const int64_t ring_nb1,
+                                        const int32_t * __restrict__ widx, const void * __restrict__ comp, const int64_t comp_nb1,
+                                        const int32_t * __restrict__ sel, const int64_t sel_s1,
+                                        half * __restrict__ dst, const int DH, const int SWA, const int K, const int M, const int RAW) {
+    const int j = blockIdx.x;
+    const int t = blockIdx.y;
+    half * out = dst + ((int64_t) t * M + j) * DH;
+    if (j < SWA) {
+        const int idx = widx[t*SWA + j];
+        if (idx < RAW) {
+            const ring_t * src = (const ring_t *) ((const char *) ring + (int64_t) idx * ring_nb1);
+            for (int e = threadIdx.x; e < DH; e += blockDim.x) {
+                out[e] = ggml_cuda_cast<half>(ggml_cuda_cast<float>(src[e]));
+            }
+        } else {
+            const float * src = kv2 + (int64_t) (idx - RAW) * DH;
+            for (int e = threadIdx.x; e < DH; e += blockDim.x) {
+                out[e] = ggml_cuda_cast<half>(src[e]);
+            }
+        }
+    } else if (j < SWA + K) {
+        const int r = sel[(int64_t) t * sel_s1 + (j - SWA)];
+        const char * row = (const char *) comp + (int64_t) r * comp_nb1;
+        if constexpr (comp_kind == 1) {
+            const float * src = (const float *) row;
+            for (int e = threadIdx.x; e < DH; e += blockDim.x) {
+                out[e] = ggml_cuda_cast<half>(src[e]);
+            }
+        } else if constexpr (comp_kind == 2) {
+            const nv_bfloat16 * src = (const nv_bfloat16 *) row;
+            for (int e = threadIdx.x; e < DH; e += blockDim.x) {
+                out[e] = ggml_cuda_cast<half>(ggml_cuda_cast<float>(src[e]));
+            }
+        } else if constexpr (comp_kind == 3) {
+            const block_nvfp4 * blocks = (const block_nvfp4 *) row;
+            for (int e = threadIdx.x; e < DH; e += blockDim.x) {
+                const block_nvfp4 & xb = blocks[e / QK_NVFP4];
+                const int sb = (e % QK_NVFP4) / QK_NVFP4_SUB;
+                const int kk = e % QK_NVFP4_SUB;
+                const float   d = ggml_cuda_ue4m3_to_fp32(xb.d[sb]);
+                const uint8_t q = xb.qs[sb*(QK_NVFP4_SUB/2) + (kk % (QK_NVFP4_SUB/2))];
+                const int   nib = kk < QK_NVFP4_SUB/2 ? (q & 0x0F) : (q >> 4);
+                const float   v = ggml_cuda_cast<float>(d * kvalues_mxfp4[nib]);
+                out[e] = ggml_cuda_cast<half>(v);
+            }
+        }
+    } else {
+        for (int e = threadIdx.x; e < DH; e += blockDim.x) {
+            out[e] = ggml_cuda_cast<half>(0.0f);
+        }
+    }
+}
+
+// dst [M, 1, 1, n] F16: wmask[t][j] for j < SWA, selm[t][j - SWA] for the compressed rows, -inf past them
+static __global__ void ds41f_attn_mask_f16(const float * __restrict__ wm, const int64_t wm_s1, const float * __restrict__ selm,
+                                           const int64_t selm_s1, half * __restrict__ dst, const int SWA, const int K, const int M,
+                                           const int64_t n) {
+    const int64_t i = (int64_t) blockIdx.x * blockDim.x + threadIdx.x;
+    if (i >= (int64_t) M * n) {
+        return;
+    }
+    const int j = (int) (i % M);
+    const int t = (int) (i / M);
+    float v;
+    if (j < SWA) {
+        v = wm[(int64_t) t * wm_s1 + j];
+    } else if (j < SWA + K) {
+        v = selm[(int64_t) t * selm_s1 + (j - SWA)];
+    } else {
+        v = -INFINITY;
+    }
+    dst[i] = ggml_cuda_cast<half>(v);
+}
+
+// ---------------------------------------------------------------- host side
+
+static float ds41f_pf(const ggml_tensor * t, int i) { return ggml_get_op_params_f32(t, i); }
+static int   ds41f_pi(const ggml_tensor * t, int i) { return ggml_get_op_params_i32(t, i); }
+static int64_t ds41f_s(const ggml_tensor * t, int d) { return (int64_t) (t->nb[d] / sizeof(float)); }
+
+bool ggml_cuda_ds41_fused_supported(const ggml_tensor * op) {
+    switch (ds41f_pi(op, 0)) {
+        case DS41F_HC_PRE_NORM:
+        case DS41F_HC_PRE_NORM_MIX:
+        case DS41F_HC_TAIL:
+        case DS41F_FFN_MIX:
+        case DS41F_FINISH:
+        case DS41F_ROUTER:
+        case DS41F_ATTN_K:
+        case DS41F_ATTN_MASK:
+            return true;
+        default:
+            return false;
+    }
+}
+
+static void ds41f_hc_pre_norm(ggml_backend_cuda_context & ctx, ggml_tensor * dst, bool from_mixes) {
+    // srcs: x [D, HC, n] F32 (any strides), pre [HC, n] F32 | mixes [24, n] F32 contiguous, (scale [3], base [24]), w [D] F32
+    // params: 1 = eps (f32), 2 = hc_eps (f32, from_mixes), 3 = hc_pre scale (f32: 1.0)
+    const ggml_tensor * x = dst->src[0];
+    const ggml_tensor * pre = dst->src[1];
+    const ggml_tensor * scale = from_mixes ? dst->src[2] : nullptr;
+    const ggml_tensor * base  = from_mixes ? dst->src[3] : nullptr;
+    const ggml_tensor * w = dst->src[from_mixes ? 4 : 2];
+    GGML_ASSERT(x->type == GGML_TYPE_F32 && pre->type == GGML_TYPE_F32 && w->type == GGML_TYPE_F32 && dst->type == GGML_TYPE_F32);
+    GGML_ASSERT(x->ne[1] == DS41F_HC && dst->ne[0] == x->ne[0] && dst->ne[1] == x->ne[2] && ggml_is_contiguous(dst));
+    GGML_ASSERT(w->ne[0] == x->ne[0] && ggml_is_contiguous(w));
+    if (from_mixes) {
+        GGML_ASSERT(ggml_is_contiguous(pre) && pre->ne[0] >= DS41F_MIX && pre->ne[1] == x->ne[2]);
+        GGML_ASSERT(ggml_nelements(scale) >= 3 && ggml_is_contiguous(scale) && ggml_nelements(base) >= DS41F_MIX && ggml_is_contiguous(base));
+    } else {
+        GGML_ASSERT(pre->ne[0] == DS41F_HC && pre->ne[1] == x->ne[2] && pre->nb[0] == sizeof(float));
+    }
+    const int ncols = (int) x->ne[0];
+    const int n = (int) x->ne[2];
+    const float eps = ds41f_pf(dst, 1), hc_eps = ds41f_pf(dst, 2), hc_scale = ds41f_pf(dst, 3);
+    const dim3 grid(n, 1, 1);
+    cudaStream_t stream = ctx.stream();
+    const float * xd = (const float *) x->data, * pd = (const float *) pre->data, * wd = (const float *) w->data;
+    const float * sd = scale ? (const float *) scale->data : nullptr, * bd = base ? (const float *) base->data : nullptr;
+    const int64_t sx0 = ds41f_s(x, 0), sx1 = ds41f_s(x, 1), sx2 = ds41f_s(x, 2);
+    const int64_t sp0 = from_mixes ? pre->ne[0] : ds41f_s(pre, 0), sp1 = from_mixes ? 0 : ds41f_s(pre, 1);
+    if (ncols < 1024) {
+        if (from_mixes) ds41f_hc_pre_norm_f32<256, true><<<grid, 256, 0, stream>>>(xd, sx0, sx1, sx2, pd, sp0, sp1, sd, bd, hc_eps, wd, (float *) dst->data, ncols, eps, hc_scale);
+        else            ds41f_hc_pre_norm_f32<256, false><<<grid, 256, 0, stream>>>(xd, sx0, sx1, sx2, pd, sp0, sp1, sd, bd, hc_eps, wd, (float *) dst->data, ncols, eps, hc_scale);
+    } else {
+        if (from_mixes) ds41f_hc_pre_norm_f32<1024, true><<<grid, 1024, 0, stream>>>(xd, sx0, sx1, sx2, pd, sp0, sp1, sd, bd, hc_eps, wd, (float *) dst->data, ncols, eps, hc_scale);
+        else            ds41f_hc_pre_norm_f32<1024, false><<<grid, 1024, 0, stream>>>(xd, sx0, sx1, sx2, pd, sp0, sp1, sd, bd, hc_eps, wd, (float *) dst->data, ncols, eps, hc_scale);
+    }
+    CUDA_CHECK(cudaGetLastError());
+}
+
+static void ds41f_hc_tail(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    // srcs: mixes [24, n] contiguous, scale [3], base [24], attn [D, n], x [D, HC, n] (the residual); dst [D, HC, n]
+    // params: 1 = hc_eps (f32), 2 = n_iter
+    const ggml_tensor * mixes = dst->src[0], * scale = dst->src[1], * base = dst->src[2], * attn = dst->src[3], * res = dst->src[4];
+    GGML_ASSERT(mixes->type == GGML_TYPE_F32 && ggml_is_contiguous(mixes) && mixes->ne[0] >= DS41F_MIX);
+    GGML_ASSERT(scale->type == GGML_TYPE_F32 && base->type == GGML_TYPE_F32 && attn->type == GGML_TYPE_F32 && res->type == GGML_TYPE_F32);
+    GGML_ASSERT(dst->type == GGML_TYPE_F32 && dst->ne[1] == DS41F_HC && res->ne[1] == DS41F_HC);
+    const int64_t D = dst->ne[0], n = dst->ne[2];
+    GGML_ASSERT(attn->ne[0] == D && attn->ne[1] == n && res->ne[0] == D && res->ne[2] == n && mixes->ne[1] == n);
+    GGML_ASSERT((D * DS41F_HC) % 256 == 0);
+    const int64_t nr = D * DS41F_HC * n;
+    const dim3 grid((nr + 255) / 256, 1, 1);
+    ds41f_hc_tail_f32<<<grid, 256, 0, ctx.stream()>>>(
+        (const float *) mixes->data, ds41f_s(mixes, 0), ds41f_s(mixes, 1), (const float *) scale->data, ds41f_s(scale, 0),
+        (const float *) base->data, ds41f_s(base, 0),
+        (const float *) attn->data, ds41f_s(attn, 0), ds41f_s(attn, 1),
+        (const float *) res->data, ds41f_s(res, 0), ds41f_s(res, 1), ds41f_s(res, 2),
+        (float *) dst->data, ds41f_s(dst, 0), ds41f_s(dst, 1), ds41f_s(dst, 2),
+        D, n, ds41f_pf(dst, 1), ds41f_pi(dst, 2));
+    CUDA_CHECK(cudaGetLastError());
+}
+
+static void ds41f_ffn_mix(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    // srcs: mixes [24, n] contiguous, scale [3], base [24], pre_out [HC, n] (written), post_out [HC, n] (written),
+    // comb_out [HC, HC, n] (written); dst = a view of post_out.  params: 1 = hc_eps (f32), 2 = n_iter
+    const ggml_tensor * mixes = dst->src[0], * scale = dst->src[1], * base = dst->src[2];
+    ggml_tensor * pre_out = dst->src[3], * post_out = dst->src[4], * comb_out = dst->src[5];
+    GGML_ASSERT(mixes->type == GGML_TYPE_F32 && ggml_is_contiguous(mixes) && mixes->ne[0] >= DS41F_MIX);
+    const int64_t n = mixes->ne[1];
+    GGML_ASSERT(pre_out->ne[0] == DS41F_HC && pre_out->ne[1] == n && post_out->ne[0] == DS41F_HC && post_out->ne[1] == n);
+    GGML_ASSERT(comb_out->ne[0] == DS41F_HC && comb_out->ne[1] == DS41F_HC && comb_out->ne[2] == n);
+    GGML_ASSERT(pre_out->type == GGML_TYPE_F32 && post_out->type == GGML_TYPE_F32 && comb_out->type == GGML_TYPE_F32);
+    const dim3 grid((n + 255) / 256, 1, 1);
+    ds41f_ffn_mix_f32<<<grid, 256, 0, ctx.stream()>>>(
+        (const float *) mixes->data, ds41f_s(mixes, 0), ds41f_s(mixes, 1), (const float *) scale->data, ds41f_s(scale, 0),
+        (const float *) base->data, ds41f_s(base, 0),
+        (float *) pre_out->data, ds41f_s(pre_out, 0), ds41f_s(pre_out, 1), (float *) post_out->data, ds41f_s(post_out, 0), ds41f_s(post_out, 1),
+        (float *) comb_out->data, ds41f_s(comb_out, 0), ds41f_s(comb_out, 1), ds41f_s(comb_out, 2), n, ds41f_pf(dst, 1), ds41f_pi(dst, 2));
+    CUDA_CHECK(cudaGetLastError());
+}
+
+static void ds41f_finish(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    // srcs: shexp [D, n], routed [D, n], hap [D, HC, n], post [HC, n], comb [HC, HC, n]; dst = a view of x_state [D, HC, n]
+    const ggml_tensor * shexp = dst->src[0], * routed = dst->src[1], * hap = dst->src[2], * post = dst->src[3], * comb = dst->src[4];
+    const int64_t D = dst->ne[0], n = dst->ne[2];
+    GGML_ASSERT(dst->type == GGML_TYPE_F32 && dst->ne[1] == DS41F_HC);
+    GGML_ASSERT(shexp->ne[0] == D && shexp->ne[1] == n && routed->ne[0] == D && routed->ne[1] == n);
+    GGML_ASSERT(hap->ne[0] == D && hap->ne[1] == DS41F_HC && hap->ne[2] == n && post->ne[0] == DS41F_HC && post->ne[1] == n);
+    GGML_ASSERT(comb->ne[0] == DS41F_HC && comb->ne[1] == DS41F_HC && comb->ne[2] == n);
+    const int64_t nr = D * DS41F_HC * n;
+    const dim3 grid((nr + 255) / 256, 1, 1);
+    ds41f_finish_f32<<<grid, 256, 0, ctx.stream()>>>(
+        (const float *) shexp->data, ds41f_s(shexp, 0), ds41f_s(shexp, 1), (const float *) routed->data, ds41f_s(routed, 0), ds41f_s(routed, 1),
+        (const float *) hap->data, ds41f_s(hap, 0), ds41f_s(hap, 1), ds41f_s(hap, 2), (const float *) post->data, ds41f_s(post, 0), ds41f_s(post, 1),
+        (const float *) comb->data, ds41f_s(comb, 0), ds41f_s(comb, 1), ds41f_s(comb, 2),
+        (float *) dst->data, ds41f_s(dst, 0), ds41f_s(dst, 1), ds41f_s(dst, 2), D, n);
+    CUDA_CHECK(cudaGetLastError());
+}
+
+template <bool full>
+static void ds41f_router_launch(const float * rl, int ncols, const float * bias, const float * rbias, int nrows, int k,
+                                float * wts, int64_t sw0, int64_t sw1, int * ids, int64_t si0, int64_t si1, int norm_topk,
+                                float den_scale, float den_bias, float w_scale, float w_bias, cudaStream_t stream) {
+    const dim3 block_dims(128, 1, 1);   // 4 rows per block
+    const dim3 block_nums((nrows + 3) / 4, 1, 1);
+    const int npl = (ncols + 31) / 32;
+#define DS41F_NPL(N) if (npl <= N) { ds41f_router_f32<N, full><<<block_nums, block_dims, 0, stream>>>(rl, ncols, bias, rbias, nrows, k, wts, sw0, sw1, ids, si0, si1, norm_topk, den_scale, den_bias, w_scale, w_bias); return; }
+    DS41F_NPL(4) DS41F_NPL(8) DS41F_NPL(12) DS41F_NPL(16)
+#undef DS41F_NPL
+    GGML_ABORT("ds41_fused router: %d columns is more than 512", ncols);
+}
+
+static void ds41f_router(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    // params: 1 = k, 2 = mode (0 full, 1 predict), 3 = norm_topk, 4 = weights_scale (f32)
+    // full:    srcs: rl [NE, n] F32 contiguous, bias [NE], rbias [NE], ids_out I32 [k, n] (written); dst F32 [k, n] = the weights
+    // predict: srcs: rl, bias, rbias; dst I32 [k, n] contiguous = the ids
+    const ggml_tensor * rl = dst->src[0], * bias = dst->src[1], * rbias = dst->src[2];
+    const int k = ds41f_pi(dst, 1), mode = ds41f_pi(dst, 2), norm_topk = ds41f_pi(dst, 3);
+    const float wscale = ds41f_pf(dst, 4);
+    GGML_ASSERT(rl->type == GGML_TYPE_F32 && ggml_is_contiguous(rl) && bias->type == GGML_TYPE_F32 && rbias->type == GGML_TYPE_F32);
+    const int ncols = (int) rl->ne[0], nrows = (int) rl->ne[1];
+    GGML_ASSERT(k >= 1 && k <= 16 && k <= ncols && ggml_nelements(bias) == ncols && ggml_nelements(rbias) == ncols);
+    GGML_ASSERT(ggml_is_contiguous(bias) && ggml_is_contiguous(rbias));
+    GGML_ASSERT(dst->ne[0] == k && dst->ne[1] == nrows);
+    cudaStream_t stream = ctx.stream();
+    if (mode == 0) {
+        ggml_tensor * ids = dst->src[3];
+        GGML_ASSERT(dst->type == GGML_TYPE_F32 && dst->nb[0] == sizeof(float));
+        GGML_ASSERT(ids->type == GGML_TYPE_I32 && ids->ne[0] == k && ids->ne[1] == nrows && ids->nb[0] == sizeof(int32_t));
+        ds41f_router_launch<true>((const float *) rl->data, ncols, (const float *) bias->data, (const float *) rbias->data, nrows, k,
+                                  (float *) dst->data, ds41f_s(dst, 0), ds41f_s(dst, 1), (int *) ids->data, (int64_t) (ids->nb[0] / 4), (int64_t) (ids->nb[1] / 4),
+                                  norm_topk, 1.0f, 1e-20f, wscale, 0.0f, stream);
+    } else {
+        GGML_ASSERT(dst->type == GGML_TYPE_I32 && ggml_is_contiguous(dst));
+        ds41f_router_launch<false>((const float *) rl->data, ncols, (const float *) bias->data, (const float *) rbias->data, nrows, k,
+                                   nullptr, 0, 0, (int *) dst->data, 1, k, 0, 1.0f, 1e-20f, 1.0f, 0.0f, stream);
+    }
+    CUDA_CHECK(cudaGetLastError());
+}
+
+static void ds41f_attn_k(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    // srcs: kv2 [DH, n] F32 contiguous, ring [DH, RAW] F32 | BF16 (rows contiguous), widx I32 [SWA*n], [comp [DH, *] F32 |
+    // BF16 | NVFP4 (rows contiguous), sel I32 [K, n] (any row stride)]; dst F16 [DH, M, 1, n] contiguous
+    // params: 1 = SWA, 2 = K, 3 = RAW
+    const ggml_tensor * kv2 = dst->src[0], * ring = dst->src[1], * widx = dst->src[2];
+    const ggml_tensor * comp = dst->src[3], * sel = dst->src[4];
+    const int SWA = ds41f_pi(dst, 1), K = ds41f_pi(dst, 2), RAW = ds41f_pi(dst, 3);
+    const int DH = (int) dst->ne[0], M = (int) dst->ne[1];
+    const int64_t n = dst->ne[3];
+    GGML_ASSERT(dst->type == GGML_TYPE_F16 && ggml_is_contiguous(dst) && dst->ne[2] == 1);
+    GGML_ASSERT(kv2->type == GGML_TYPE_F32 && ggml_is_contiguous(kv2) && kv2->ne[0] == DH && kv2->ne[1] == n);
+    GGML_ASSERT((ring->type == GGML_TYPE_F32 || ring->type == GGML_TYPE_BF16) && ring->ne[0] == DH && ring->ne[1] == RAW && ring->nb[0] == ggml_type_size(ring->type));
+    GGML_ASSERT(widx->type == GGML_TYPE_I32 && ggml_nelements(widx) >= (int64_t) SWA * n && ggml_is_contiguous(widx));
+    GGML_ASSERT(SWA + K <= M && K >= 0);
+    int comp_kind = 0;
+    if (K > 0) {
+        GGML_ASSERT(comp && sel && sel->type == GGML_TYPE_I32 && sel->ne[0] >= K && sel->ne[1] >= n && sel->nb[0] == sizeof(int32_t));
+        GGML_ASSERT(comp->ne[0] == DH);
+        if (comp->type == GGML_TYPE_F32) comp_kind = 1;
+        else if (comp->type == GGML_TYPE_BF16) comp_kind = 2;
+        else if (comp->type == GGML_TYPE_NVFP4) { comp_kind = 3; GGML_ASSERT(DH % QK_NVFP4 == 0); }
+        else GGML_ABORT("ds41_fused attn_k: compressed rows of type %s", ggml_type_name(comp->type));
+    }
+    const dim3 grid(M, (unsigned) n, 1);
+    cudaStream_t stream = ctx.stream();
+    const float * kvd = (const float *) kv2->data;
+    const void * rd = ring->data;
+    const int64_t rnb1 = (int64_t) ring->nb[1];
+    const int32_t * wd = (const int32_t *) widx->data;
+    const void * cd = K > 0 ? comp->data : nullptr;
+    const int64_t cnb1 = K > 0 ? (int64_t) comp->nb[1] : 0;
+    const int32_t * sd = K > 0 ? (const int32_t *) sel->data : nullptr;
+    const int64_t ss1 = K > 0 ? (int64_t) (sel->nb[1] / 4) : 0;
+    half * od = (half *) dst->data;
+#define DS41F_K(RT, CK) ds41f_attn_k_f16<RT, CK><<<grid, 128, 0, stream>>>(kvd, rd, rnb1, wd, cd, cnb1, sd, ss1, od, DH, SWA, K, M, RAW)
+    if (ring->type == GGML_TYPE_F32) {
+        switch (comp_kind) { case 0: DS41F_K(float, 0); break; case 1: DS41F_K(float, 1); break; case 2: DS41F_K(float, 2); break; default: DS41F_K(float, 3); break; }
+    } else {
+        switch (comp_kind) { case 0: DS41F_K(nv_bfloat16, 0); break; case 1: DS41F_K(nv_bfloat16, 1); break; case 2: DS41F_K(nv_bfloat16, 2); break; default: DS41F_K(nv_bfloat16, 3); break; }
+    }
+#undef DS41F_K
+    CUDA_CHECK(cudaGetLastError());
+}
+
+static void ds41f_attn_mask(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    // srcs: wmask [SWA, n] F32 (any row stride), [selm [K, n] F32 (any row stride)]; dst F16 [M, 1, 1, n] contiguous
+    // params: 1 = SWA, 2 = K
+    const ggml_tensor * wm = dst->src[0], * selm = dst->src[1];
+    const int SWA = ds41f_pi(dst, 1), K = ds41f_pi(dst, 2);
+    const int M = (int) dst->ne[0];
+    const int64_t n = dst->ne[3];
+    GGML_ASSERT(dst->type == GGML_TYPE_F16 && ggml_is_contiguous(dst) && dst->ne[1] == 1 && dst->ne[2] == 1);
+    GGML_ASSERT(wm->type == GGML_TYPE_F32 && wm->ne[0] == SWA && wm->ne[1] >= n && wm->nb[0] == sizeof(float));
+    if (K > 0) GGML_ASSERT(selm && selm->type == GGML_TYPE_F32 && selm->ne[0] >= K && selm->ne[1] >= n && selm->nb[0] == sizeof(float));
+    GGML_ASSERT(SWA + K <= M);
+    const int64_t total = (int64_t) M * n;
+    const dim3 grid((total + 255) / 256, 1, 1);
+    ds41f_attn_mask_f16<<<grid, 256, 0, ctx.stream()>>>((const float *) wm->data, ds41f_s(wm, 1), K > 0 ? (const float *) selm->data : nullptr,
+                                                        K > 0 ? ds41f_s(selm, 1) : 0, (half *) dst->data, SWA, K, M, n);
+    CUDA_CHECK(cudaGetLastError());
+}
+
+void ggml_cuda_op_ds41_fused(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const int sub = ds41f_pi(dst, 0);
+    switch (sub) {
+        case DS41F_HC_PRE_NORM:     ds41f_hc_pre_norm(ctx, dst, false); break;
+        case DS41F_HC_PRE_NORM_MIX: ds41f_hc_pre_norm(ctx, dst, true);  break;
+        case DS41F_HC_TAIL:         ds41f_hc_tail(ctx, dst);  break;
+        case DS41F_FFN_MIX:         ds41f_ffn_mix(ctx, dst);  break;
+        case DS41F_FINISH:          ds41f_finish(ctx, dst);   break;
+        case DS41F_ROUTER:          ds41f_router(ctx, dst);   break;
+        case DS41F_ATTN_K:          ds41f_attn_k(ctx, dst);   break;
+        case DS41F_ATTN_MASK:       ds41f_attn_mask(ctx, dst); break;
+        default:
+            GGML_ABORT("ds41_fused: unknown sub-op %d", sub);
+    }
+}
